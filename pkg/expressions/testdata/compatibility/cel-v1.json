{
  "format": "inngest.cel.compatibility",
  "version": 1,
  "provenance": "Hand-authored portable vectors grounded in pkg/expressions behavior and its existing tests. Expected values are literals; they are not generated by the Go evaluator.",
  "normalization": {
    "input": "Inputs are JSON objects. Omitted keys are absent; explicit null remains present. JSON numbers use the consumer's JSON number model; Go encoding/json decodes them as float64.",
    "result": "Successful cases require a boolean result. Error cases pin only whether failure occurs during compile or evaluation; engine-specific error text is not stable contract.",
    "time_and_ids": "These vectors do not use timestamps, generated IDs, or time-dependent functions. Future time values must be explicit Unix milliseconds; IDs must be literal fixture values."
  },
  "cases": [
    {
      "id": "missing-nested-field-compares-equal-to-null",
      "expression": "event.data.profile.region == null",
      "input": {
        "event": {
          "data": {
            "profile": {}
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "explicit-nested-null-is-present",
      "expression": "has(event.data.profile.region)",
      "input": {
        "event": {
          "data": {
            "profile": {
              "region": null
            }
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "missing-nested-field-is-not-present",
      "expression": "!has(event.data.profile.region)",
      "input": {
        "event": {
          "data": {
            "profile": {}
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "json-number-compares-with-cel-integer",
      "expression": "event.data.total == 42",
      "input": {
        "event": {
          "data": {
            "total": 42.0
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "logical-or-uses-truthy-fallback",
      "expression": "(event.data.primary || event.data.fallback) == \"backup\"",
      "input": {
        "event": {
          "data": {
            "primary": "",
            "fallback": "backup"
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "custom-uppercase-function",
      "expression": "uppercase(event.data.profile.name) == \"INNGEST\"",
      "input": {
        "event": {
          "data": {
            "profile": {
              "name": "Inngest"
            }
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "mixed-numeric-custom-nested-workload",
      "expression": "uppercase(event.data.profile.name) == \"INNGEST\" && event.data.total >= 40",
      "input": {
        "event": {
          "data": {
            "profile": {
              "name": "Inngest"
            },
            "total": 42.0
          }
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "id": "partial-unknown-greater-than-is-false",
      "expression": "event.data.pending > 5",
      "input": {
        "event": {
          "data": {}
        }
      },
      "expected": {
        "result": false
      }
    },
    {
      "id": "invalid-expression-fails-during-compile",
      "expression": "event.data.value === \"x\"",
      "input": {
        "event": {
          "data": {
            "value": "x"
          }
        }
      },
      "expected": {
        "error_stage": "compile"
      }
    },
    {
      "id": "wrong-runtime-type-fails-during-evaluation",
      "expression": "event.data.value.matches(\"x\")",
      "input": {
        "event": {
          "data": {
            "value": 1
          }
        }
      },
      "expected": {
        "error_stage": "evaluation"
      }
    }
  ]
}
